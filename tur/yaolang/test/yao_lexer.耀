## 曜语自举 — 词法分析器
## 文件: yao_lexer.耀
## 用曜语写的曜语词法分析器！自举的第一步！
## ═══════════════════════════════════════════════════════════════════════════

## 词元类型编码:
##   1=整数  2=浮点  3=文本  4=标识符  5=关键字  6=符号  7=错误
##   0=终结

## ─── 字符判断函数 ───

函数 是数字(整数 c): 整数 {
    若 c >= 48 && c <= 57 {
        返回 1
    }
    返回 0
}

函数 是字母(整数 c): 整数 {
    若 (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
        返回 1
    }
    返回 0
}

函数 是下划线(整数 c): 整数 {
    若 c == 95 {
        返回 1
    }
    返回 0
}

函数 是空白(整数 c): 整数 {
    若 c == 32 || c == 9 || c == 13 || c == 10 {
        返回 1
    }
    返回 0
}

函数 是中文字(整数 c): 整数 {
    若 c >= 19968 && c <= 40863 {
        返回 1
    }
    返回 0
}

## ─── 主函数: 读取源文件并执行词法分析 ───

函数 主函数() {
    _yao_print_s("═══════════════════════════════════════")
    _yao_print_s("  曜语自举 — 词法分析器 (用曜语写)")
    _yao_print_s("═══════════════════════════════════════")

    ## 读取曜语源文件
    变量 源码: 文本 = _yao_read_file("test/hello.耀")
    
    若 _yao_strlen(源码) == 0 {
        _yao_print_s("错误: 无法读取源文件或文件为空")
        返回 0
    }
    
    _yao_print_s("源文件读取成功, 长度=")
    _yao_print(_yao_strlen(源码))
    _yao_print_s("")
    _yao_print_s("─── 词法分析结果 ───")
    
    ## 逐字符扫描
    变量 i: 整数 = 0
    变量 len: 整数 = _yao_strlen(源码)
    变量 词元数: 整数 = 0
    
    当 i < len {
        变量 c: 整数 = _yao_char_at(源码, i)
        
        ## 跳过空白
        若 是空白(c) == 1 {
            i = i + 1
            继续
        }
        
        ## 跳过注释 ## 或 //
        若 c == 35 && i + 1 < len {
            变量 c2: 整数 = _yao_char_at(源码, i + 1)
            若 c2 == 35 {
                当 i < len && _yao_char_at(源码, i) != 10 {
                    i = i + 1
                }
                继续
            }
        }
        若 c == 47 && i + 1 < len {
            变量 c2: 整数 = _yao_char_at(源码, i + 1)
            若 c2 == 47 {
                当 i < len && _yao_char_at(源码, i) != 10 {
                    i = i + 1
                }
                继续
            }
        }
        
        ## 整数
        若 是数字(c) == 1 {
            变量 起始: 整数 = i
            当 i < len {
                变量 ch: 整数 = _yao_char_at(源码, i)
                若 是数字(ch) == 1 {
                    i = i + 1
                }
                否则 {
                    跳出
                }
            }
            变量 子串: 文本 = _yao_substr(源码, 起始, i - 起始)
            _yao_print_s("  [整数] ")
            _yao_print_s(子串)
            词元数 = 词元数 + 1
            继续
        }
        
        ## 字符串
        若 c == 34 {
            i = i + 1
            变量 起始: 整数 = i
            当 i < len && _yao_char_at(源码, i) != 34 {
                i = i + 1
            }
            变量 子串: 文本 = _yao_substr(源码, 起始, i - 起始)
            _yao_print_s("  [文本] \"")
            _yao_print_s(子串)
            _yao_print_s("\"")
            词元数 = 词元数 + 1
            若 i < len {
                i = i + 1
            }
            继续
        }
        
        ## 标识符 (ASCII或中文)
        若 是字母(c) == 1 || 是下划线(c) == 1 || 是中文字(c) == 1 {
            变量 起始: 整数 = i
            当 i < len {
                变量 ch: 整数 = _yao_char_at(源码, i)
                若 是字母(ch) == 1 || 是下划线(ch) == 1 || 是中文字(ch) == 1 || 是数字(ch) == 1 {
                    i = i + 1
                }
                否则 {
                    跳出
                }
            }
            变量 子串: 文本 = _yao_substr(源码, 起始, i - 起始)
            _yao_print_s("  [标识] ")
            _yao_print_s(子串)
            词元数 = 词元数 + 1
            继续
        }
        
        ## 单字符符号
        _yao_print_s("  [符号] '")
        变量 sym: 文本 = _yao_substr(源码, i, 1)
        _yao_print_s(sym)
        _yao_print_s("'")
        词元数 = 词元数 + 1
        i = i + 1
    }
    
    _yao_print_s("")
    _yao_print_s("─── 词法分析完成 ───")
    _yao_print_s("总词元数: ")
    _yao_print(词元数)
    _yao_print_s("")
    _yao_print_s("★ 曜语词法分析器用曜语自身实现了！自举第一步成功！")
}