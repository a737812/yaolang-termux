## 曜语图形化 — X11 窗口程序
## 文件: gui_window.耀
## 用曜语写一个真正的图形窗口！有按钮、文字、动画！
## ═══════════════════════════════════════════════════════════════════════════

函数 主函数() {
    _yao_print_s("═══════════════════════════════════════")
    _yao_print_s("  曜语图形化 — X11 窗口")
    _yao_print_s("═══════════════════════════════════════")

    ## 创建窗口 640x480
    变量 win: 整数 = _yao_x11_create_window(640, 480, "曜语图形窗口 - YaoLang GUI")
    
    若 win == 0 {
        _yao_print_s("错误: 无法创建X11窗口 (可能没有显示服务器)")
        返回 1
    }
    
    _yao_print_s("窗口创建成功!")
    
    ## 绘制标题文字
    _yao_x11_draw_text(win, 200, 50, "YaoLang GUI")
    _yao_x11_draw_text(win, 180, 80, "曜语图形化窗口")
    
    ## 绘制按钮区域 (矩形框)
    _yao_x11_draw_rect(win, 220, 150, 200, 50)
    _yao_x11_draw_text(win, 270, 180, "点击我!")
    
    ## 绘制第二个按钮
    _yao_x11_draw_rect(win, 220, 230, 200, 50)
    _yao_x11_draw_text(win, 260, 260, "退出按钮")
    
    ## 绘制装饰图形
    _yao_x11_draw_circle(win, 100, 350, 40)
    _yao_x11_draw_circle(win, 540, 350, 40)
    _yao_x11_draw_line(win, 100, 350, 540, 350)
    
    ## 绘制方格装饰
    _yao_x11_fill_rect(win, 50, 100, 30, 30)
    _yao_x11_fill_rect(win, 560, 100, 30, 30)
    
    _yao_print_s("图形绘制完成, 等待按键...")
    _yao_print_s("  (在窗口中按任意键退出)")
    
    ## 事件循环: 等待按键
    _yao_x11_loop(win)
    
    _yao_x11_close()
    _yao_print_s("窗口已关闭")
    _yao_print_s("★ 曜语GUI程序成功运行!")
}